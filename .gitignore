# Dependency directories
node_modules/
backend/.venv/
backend/__pycache__/
backend/.pytest_cache/
.pytest_cache/
__pycache__/

# Build outputs
dist/
build/
frontend/dist/

# Local configuration and credentials (CRITICAL: Do not commit API keys!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
backend/.env

# Local SQLite database (generated by seed.py)
*.db
backend/*.db
# WAL-mode sidecar files (not matched by *.db)
*.db-wal
*.db-shm
*.db-journal
# Timestamped SQLite backups (not matched by *.db)
*.db.bak_*
*.bak

# Generated tooling output (understand-anything knowledge graph)
.understand-anything/
.ua/

# IDE, Editor, and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Claude Code local state (worktrees are full repo copies; settings are per-machine)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
