# --- Real-time voice pipeline (required only for the /ws/chat voice assistant) ---
# The REST API, recipe catalogue, semantic search, and auth all work without these.
# Text-to-speech is handled in the browser (Web Speech API) — no key required.
DEEPGRAM_API_KEY=your_deepgram_api_key       # streaming speech-to-text

# --- LLM providers (the frontend model selector picks one per session) ---
# "Llama" option -> Groq. Required for the default provider.
GROQ_API_KEY=your_groq_api_key               # Groq tool-calling LLM agent (https://console.groq.com/keys)
# GROQ_MODEL=llama-3.1-8b-instant            # override the Groq agent model (faster)

# "Nemotron" option -> OpenRouter (NVIDIA Nemotron 3 Nano, free, supports tools).
# Nano 30B is fast (~1-3s) and isn't throttled like the huge Ultra model.
# Get a key at https://openrouter.ai/keys
OPEN_API_KEY=your_openrouter_api_key         # a.k.a. OPENROUTER_API_KEY
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free  # override the OpenRouter model

# "Gemma" option -> a local model served by Ollama (no API key, runs on your
# machine, auto-splits across VRAM+RAM when it doesn't fit the GPU). One-time
# import of your GGUF (see backend/Modelfile.gemma):
#   ollama create chefvoice-gemma -f backend/Modelfile.gemma
# Then just make sure `ollama serve` is running. Overrides (rarely needed):
# LOCAL_LLM_MODEL=chefvoice-gemma                      # the ollama model name
# LOCAL_LLM_BASE_URL=http://localhost:11434/api/chat   # ollama native chat endpoint
# OLLAMA_KEEP_ALIVE=30m                                # keep the model warm between turns

# Which provider is used when the client doesn't specify one (llama | nvidia | local).
# DEFAULT_MODEL_PROVIDER=llama
# CHEFVOICE_DEBUG=1                           # verbose agent/tool tracing in logs

# --- Authentication ---
# Secret used to sign JWT session tokens. Use a long, random value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRY_DAYS=7

# --- Optional ---
# Comma-separated list of frontend origins allowed by CORS.
# FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Path to the SQLite database file (defaults to backend/chefvoice.db).
# CHEFVOICE_DB=chefvoice.db
