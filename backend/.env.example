# --- Real-time voice pipeline (required only for the /ws/chat voice assistant) ---
# The REST API, recipe catalogue, semantic search, and auth all work without these.
DEEPGRAM_API_KEY=your_deepgram_api_key       # streaming speech-to-text
GROQ_API_KEY=your_groq_api_key               # Llama-3.3 intent routing (LLM)
ELEVENLABS_API_KEY=your_elevenlabs_api_key   # streaming text-to-speech

# --- Authentication ---
# Secret used to sign JWT session tokens. Use a long, random value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRY_DAYS=7

# --- Optional ---
# Comma-separated list of frontend origins allowed by CORS.
# FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Path to the SQLite database file (defaults to backend/chefvoice.db).
# CHEFVOICE_DB=chefvoice.db
